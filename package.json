{
  "name": "carnet-sobre",
  "version": "1.0.0",
  "private": true,
  "description": "Blog Carnet Sobre : interface statique et fonctionnalités dynamiques (ECF TP DWWM, CCP1)",
  "scripts": {
    "test": "jest",
